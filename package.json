{
  "name": "lynel-desktop",
  "productName": "Lynel Desktop",
  "version": "0.0.21",
  "private": true,
  "main": "dist-electron/src/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-cleanup.mjs && tsc && concurrently --kill-others-on-fail \"npm run dev:frontend\" \"npm run dev:electron\" \"npm run dev:app\"",
    "dev:stop": "node scripts/dev-cleanup.mjs",
    "dev:frontend": "cd src/renderer && vite",
    "dev:electron": "tsc --watch",
    "dev:app": "wait-on http://localhost:5180 && electron .",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd src/renderer && npx vue-tsc --noEmit && npx vite build",
    "build:electron": "tsc",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "node scripts/pre-dist-mac.mjs && electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test": "vitest run --dir tests/main",
    "test:main": "vitest run --dir tests/main",
    "test:smoke": "npx tsx --test scripts/smoke-test.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "concurrently": "^9.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.0",
    "socket.io": "^4.8.3",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "^0.1.0-rc.6",
    "@napi-rs/canvas": "^0.1.68",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "@wecom/wecom-openclaw-plugin": "^20206.7.201",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^4.0.0",
    "electron-log": "^5.0.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "node-pty": "^1.0.0",
    "openclaw": "file:vendor/openclaw-stub",
    "socket.io-client": "^4.8.3",
    "tree-kill": "^1.2.2",
    "undici": "^7.24.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild"
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "@deepseek-ai/dsh-subprocess-local": true,
    "@google/genai": true,
    "esbuild": true,
    "koffi": true,
    "node-pty": true,
    "protobufjs": true
  }
}
