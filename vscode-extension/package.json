{
  "name": "lynel-vscode",
  "displayName": "Lynel - Claude AI Terminal",
  "description": "Embed Claude AI interactive terminal in VS Code",
  "version": "0.0.25",
  "publisher": "lynel",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lynel.newTerminal",
        "title": "Lynel: New Claude Terminal",
        "icon": "$(add)"
      },
      {
        "command": "lynel.newTerminalWithWorkDir",
        "title": "Lynel: New Claude Terminal in Workspace"
      },
      {
        "command": "lynel.closeAllTerminals",
        "title": "Lynel: Close All Terminals",
        "icon": "$(close-all)"
      },
      {
        "command": "lynel.showSettings",
        "title": "Lynel: Open Settings"
      },
      {
        "command": "lynel.bindWecomBot",
        "title": "Lynel: Bind WeCom Bot"
      },
      {
        "command": "lynel.manageWecomBots",
        "title": "Lynel: Manage WeCom Bots",
        "icon": "$(gear)"
      },
      {
        "command": "lynel.switchBotBinding",
        "title": "Lynel: Switch Bot Binding"
      },
      {
        "command": "lynel.focusTerminal",
        "title": "Lynel: Focus Terminal"
      },
      {
        "command": "lynel.focusOrResumeTerminal",
        "title": "Lynel: Focus or Resume Terminal",
        "icon": "$(play)"
      },
      {
        "command": "lynel.closeTerminal",
        "title": "Lynel: Close Terminal",
        "icon": "$(trash)"
      },
      {
        "command": "lynel.bindBotToSession",
        "title": "Lynel: Bind Bot to Session",
        "icon": "$(plug)"
      },
      {
        "command": "lynel.unbindBotFromSession",
        "title": "Lynel: Unbind Bot from Session",
        "icon": "$(unplug)"
      }
    ],
    "configuration": {
      "title": "Lynel",
      "properties": {
        "lynel.claudeBin": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude CLI binary"
        },
        "lynel.dataDir": {
          "type": "string",
          "default": "",
          "description": "Lynel data directory (default: ~/.lynel-desktop)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lynel",
          "title": "Lynel",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "lynel": [
        {
          "id": "lynel.sessions",
          "name": "Sessions",
          "when": ""
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lynel.newTerminal",
          "group": "navigation",
          "when": "view == lynel.sessions"
        },
        {
          "command": "lynel.manageWecomBots",
          "group": "navigation",
          "when": "view == lynel.sessions"
        },
        {
          "command": "lynel.closeAllTerminals",
          "group": "navigation",
          "when": "view == lynel.sessions"
        }
      ],
      "view/item/context": [
        {
          "command": "lynel.focusOrResumeTerminal",
          "group": "inline",
          "when": "view == lynel.sessions && viewItem == lynelSession"
        },
        {
          "command": "lynel.bindBotToSession",
          "group": "inline",
          "when": "view == lynel.sessions && viewItem == lynelSession"
        },
        {
          "command": "lynel.closeTerminal",
          "group": "inline",
          "when": "view == lynel.sessions && viewItem == lynelSession"
        },
        {
          "command": "lynel.focusOrResumeTerminal",
          "group": "1_open@1",
          "when": "view == lynel.sessions && viewItem == lynelSession"
        },
        {
          "command": "lynel.bindBotToSession",
          "group": "2_bot@1",
          "when": "view == lynel.sessions && viewItem == lynelSession"
        },
        {
          "command": "lynel.unbindBotFromSession",
          "group": "2_bot@2",
          "when": "view == lynel.sessions && viewItem == lynelSession"
        },
        {
          "command": "lynel.closeTerminal",
          "group": "3_close@1",
          "when": "view == lynel.sessions && viewItem == lynelSession"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lynel.sessions",
        "contents": "还没有活跃的 Claude 终端会话。\n[新建终端](command:lynel.newTerminal)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "pretest": "npm run compile",
    "test": "echo 'No tests yet'",
    "package": "vsce package"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "@wecom/wecom-openclaw-plugin": "^20206.7.201"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
