{
  "name": "lynel-vscode",
  "displayName": "Lynel - Claude AI Terminal",
  "description": "Embed Claude AI interactive terminal in VS Code",
  "version": "0.0.14",
  "publisher": "lynel",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lynel.newTerminal",
        "title": "Lynel: New Claude Terminal"
      },
      {
        "command": "lynel.newTerminalWithWorkDir",
        "title": "Lynel: New Claude Terminal in Workspace"
      },
      {
        "command": "lynel.closeAllTerminals",
        "title": "Lynel: Close All Terminals"
      },
      {
        "command": "lynel.showSettings",
        "title": "Lynel: Open Settings"
      },
      {
        "command": "lynel.bindWecomBot",
        "title": "Lynel: Bind WeCom Bot"
      },
      {
        "command": "lynel.manageWecomBots",
        "title": "Lynel: Manage WeCom Bots"
      },
      {
        "command": "lynel.switchBotBinding",
        "title": "Lynel: Switch Bot Binding"
      }
    ],
    "configuration": {
      "title": "Lynel",
      "properties": {
        "lynel.claudeBin": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude CLI binary"
        },
        "lynel.dataDir": {
          "type": "string",
          "default": "",
          "description": "Lynel data directory (default: ~/.lynel-desktop)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "pretest": "npm run compile",
    "test": "echo 'No tests yet'",
    "package": "vsce package"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "@wecom/wecom-openclaw-plugin": "^20206.7.201"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
